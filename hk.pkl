amends ".hk/org.pkl"

steps {
  ["cargo-lockfile"] = new Step {
    glob = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml")
    check = "cargo metadata --locked --format-version 1 --all-features > /dev/null"
    profiles = List("slow")
  }

  // The step of the organization sets `workspace_indicator = null`, so the `{{workspace}}` in the
  // builtin `dir` has no value.
  ["cargo-deny"] { dir = "{{root}}" }
}
